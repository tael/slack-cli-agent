# 봇별 실제 설정과 상태. 조직 고유값이 들어간다
profiles/*.json
!profiles/*.example.json
# 슬랙 앱 매니페스트 정본. 봇 표시명과 설명이 들어가 프로필과 성질이 같다.
# 정책 원천인 _template.json 만 올린다
slack-apps/*.json
!slack-apps/_template.json
prompts/*.md
!prompts/*.md.example
persona/
*.local.json

# 상태와 산출물
*.db
*.db-wal
*.db-shm
*.jsonl
*.pid
*.log
# 백그라운드 감시 산출물. 봇이 작업 디렉터리에 만든다
.watch-out/

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/
